<#
.SYNOPSIS
  MSP backup agent installer for machine "@@MACHINE@@" (customer "@@CUSTOMER@@", site "@@SITE@@").
  Generated by scripts/build-backup-installer.sh - do not edit by hand.

.DESCRIPTION
  Installs restic (pinned version, SHA256-verified) and a daily scheduled task "MSPBackup" that backs this machine up
  over HTTPS to the MSP backup server. The server is append-only: this machine can add backups but cannot delete or
  change existing ones, so ransomware on this PC cannot erase its own history. Safe to re-run (upgrade/repair).

.PARAMETER Uninstall
  Remove the scheduled task and the local files. Backups already on the server are NOT touched.
.PARAMETER RunNow
  Start the first backup immediately after installing (it can take hours on a large machine).
.PARAMETER Paths
  Back up only these paths instead of every fixed drive (for testing or per-customer scope).
.PARAMETER AllowNameMismatch
  Credentials in this file belong to one machine; installing on a different computer is refused unless you pass this.

.NOTES
  Run from an elevated PowerShell:
      powershell -ExecutionPolicy Bypass -File .\install-backup-@@MACHINE@@.ps1
  This file contains this machine's backup credentials, including the password that decrypts its backups. Treat it as
  sensitive: deliver it securely and delete it after use.
#>
[CmdletBinding()]
param(
    [switch]   $Uninstall,
    [switch]   $RunNow,
    [string[]] $Paths,
    [switch]   $AllowNameMismatch,
    [string]   $InstallDir = (Join-Path $env:ProgramFiles 'MSP-Backup')
)
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version 2.0

$Machine     = '@@MACHINE@@'
$ServerHost  = '@@SERVER_HOST@@'
$RestUser    = '@@REST_USER@@'
$RestPass    = '@@REST_PASS@@'
$RepoPass    = '@@REPO_PASS@@'
$Customer    = '@@CUSTOMER@@'
$Site        = '@@SITE@@'
$ResticUrl   = '@@RESTIC_URL@@'
$ResticSha   = '@@RESTIC_SHA256@@'
$StartTime   = '@@TIME@@'
$DefaultPaths = @('@@PATHS@@')
$WrapperB64  = '@@WRAPPER_B64@@'
$CommonB64   = '@@COMMON_B64@@'
$PollB64     = '@@POLL_B64@@'
$PortalUrl   = '@@PORTAL_URL@@'          # empty = this machine is not managed from the portal
$AgentToken  = '@@AGENT_TOKEN@@'
$ExcludesB64 = '@@EXCLUDES_B64@@'
$TaskName    = 'MSPBackup'
$PollTaskName = 'MSPBackupPoll'

function Write-Step([string] $Message) { Write-Host "[MSP Backup] $Message" }

# Windows PowerShell 5.1 turns ANY stderr text from a program into a terminating error under 'Stop'; judge by exit code.
function Invoke-Native([string] $Exe, [string[]] $Arguments) {
    $previous = $ErrorActionPreference
    $ErrorActionPreference = 'Continue'
    try { $lines = & $Exe @Arguments 2>&1 | ForEach-Object { "$_" }; $code = $LASTEXITCODE }
    finally { $ErrorActionPreference = $previous }
    return [pscustomobject]@{ ExitCode = $code; Output = ($lines -join "`n") }
}

$identity  = [Security.Principal.WindowsIdentity]::GetCurrent()
$principal = New-Object Security.Principal.WindowsPrincipal($identity)
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    throw 'This installer must be run from an elevated (Administrator) PowerShell.'
}
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

$thisName = ($env:COMPUTERNAME.ToLower() -replace '_', '-')
if (-not $Uninstall -and $thisName -ne $Machine -and -not $AllowNameMismatch) {
    throw "These credentials are for machine '$Machine' but this computer is '$thisName'. Refusing (use -AllowNameMismatch to override)."
}

$logDir = Join-Path $env:ProgramData 'MSP-Backup'
New-Item -ItemType Directory -Force -Path $logDir | Out-Null
Start-Transcript -Path (Join-Path $logDir 'install.log') -Append | Out-Null

try {
    $taskPath = '\MSP\'
    $existing = Get-ScheduledTask -TaskName $TaskName -TaskPath $taskPath -ErrorAction SilentlyContinue
    # The check-in script keeps running for hours, so stop the old copy: the files below are replaced and the new one
    # starts within a minute (it is only started again when the poll task is registered further down).
    Stop-ScheduledTask -TaskName $PollTaskName -TaskPath $taskPath -ErrorAction SilentlyContinue

    if ($Uninstall) {
        if ($existing) { Unregister-ScheduledTask -TaskName $TaskName -TaskPath $taskPath -Confirm:$false }
        if (Get-ScheduledTask -TaskName $PollTaskName -TaskPath $taskPath -ErrorAction SilentlyContinue) { Unregister-ScheduledTask -TaskName $PollTaskName -TaskPath $taskPath -Confirm:$false }
        if (Test-Path $InstallDir) { Remove-Item -Recurse -Force -Path $InstallDir }
        Write-Step 'Uninstalled. Backups already stored on the server were not touched.'
        return
    }

    # --- 1. download restic and verify -----------------------------------------------------------------------------
    $work = Join-Path ([IO.Path]::GetTempPath()) ('msp-backup-' + [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Path $work | Out-Null
    try {
        $zip = Join-Path $work 'restic.zip'
        $verified = $false
        for ($attempt = 1; $attempt -le 4 -and -not $verified; $attempt++) {
            try {
                Write-Step "Downloading restic (attempt $attempt of 4)..."
                Invoke-WebRequest -Uri $ResticUrl -OutFile $zip -UseBasicParsing
                if ((Get-FileHash -Path $zip -Algorithm SHA256).Hash.ToLower() -eq $ResticSha) { $verified = $true }
                else { Write-Step 'Download did not match the pinned SHA256 (incomplete or altered); discarding.' }
            } catch { Write-Step "Download failed: $($_.Exception.Message)" }
            if (-not $verified) {
                if (Test-Path $zip) { Remove-Item -Force -Path $zip }
                if ($attempt -lt 4) { Start-Sleep -Seconds (3 * $attempt) }
            }
        }
        if (-not $verified) { throw 'Could not obtain a restic build matching the pinned SHA256. Nothing was installed.' }
        Write-Step 'Download verified (SHA256 matches).'
        Expand-Archive -Path $zip -DestinationPath (Join-Path $work 'x') -Force
        $exe = Get-ChildItem -Path (Join-Path $work 'x') -Recurse -Filter 'restic*.exe' | Select-Object -First 1
        if (-not $exe) { throw 'restic.exe not found in the downloaded archive.' }

        # --- 2. stop a running backup, then lay down files ---------------------------------------------------------
        if ($existing) { Write-Step 'Existing install found; updating it.'; Stop-ScheduledTask -TaskName $TaskName -TaskPath $taskPath -ErrorAction SilentlyContinue }
        New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null
        Copy-Item -Path $exe.FullName -Destination (Join-Path $InstallDir 'restic.exe') -Force

        $noBom = New-Object Text.UTF8Encoding($false)
        [IO.File]::WriteAllBytes((Join-Path $InstallDir 'msp-backup.ps1'), [Convert]::FromBase64String($WrapperB64))
        [IO.File]::WriteAllBytes((Join-Path $InstallDir 'excludes.txt'),   [Convert]::FromBase64String($ExcludesB64))
        [IO.File]::WriteAllBytes((Join-Path $InstallDir 'msp-common.ps1'), [Convert]::FromBase64String($CommonB64))
        [IO.File]::WriteAllBytes((Join-Path $InstallDir 'msp-poll.ps1'),   [Convert]::FromBase64String($PollB64))
        [IO.File]::WriteAllText((Join-Path $InstallDir 'repo.pass'), $RepoPass, $noBom)
        $pathsToUse = if ($Paths -and $Paths.Count -gt 0) { @($Paths) } else { @($DefaultPaths) }
        $config = [ordered]@{ machine = $Machine; customer = $Customer; site = $Site; server_host = $ServerHost
                              rest_user = $RestUser; rest_pass = $RestPass; paths = $pathsToUse }
        if ($PortalUrl -and $AgentToken) { $config.portal_url = $PortalUrl; $config.agent_token = $AgentToken }
        [IO.File]::WriteAllText((Join-Path $InstallDir 'config.json'), ($config | ConvertTo-Json), $noBom)

        # SYSTEM + Administrators only, by well-known SID (works on any Windows language). This folder holds secrets.
        $acl = Invoke-Native 'icacls.exe' @($InstallDir, '/inheritance:r', '/grant:r', '*S-1-5-18:(OI)(CI)F', '*S-1-5-32-544:(OI)(CI)F')
        if ($acl.ExitCode -ne 0) { throw "Could not restrict permissions on ${InstallDir}: $($acl.Output)" }

        # --- 3. prove the repository is reachable with these credentials BEFORE scheduling anything ---------------
        Write-Step 'Checking the connection to the backup server...'
        $test = Invoke-Native 'powershell.exe' @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', (Join-Path $InstallDir 'msp-backup.ps1'), '-Test')
        if ($test.ExitCode -ne 0) { throw "The backup server check failed:`n$($test.Output)" }
        Write-Step $test.Output.Trim()

        # --- 4. schedule the daily backup --------------------------------------------------------------------------
        $action    = New-ScheduledTaskAction -Execute 'powershell.exe' `
                       -Argument ('-NoProfile -ExecutionPolicy Bypass -File "{0}"' -f (Join-Path $InstallDir 'msp-backup.ps1'))
        $trigger   = New-ScheduledTaskTrigger -Daily -At $StartTime
        $taskUser  = New-ScheduledTaskPrincipal -UserId 'SYSTEM' -LogonType ServiceAccount -RunLevel Highest
        $settings  = New-ScheduledTaskSettingsSet -StartWhenAvailable -MultipleInstances IgnoreNew `
                       -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit (New-TimeSpan -Hours 12)
        Register-ScheduledTask -TaskName $TaskName -TaskPath $taskPath -Action $action -Trigger $trigger `
            -Principal $taskUser -Settings $settings -Description 'MSP daily backup (restic, append-only server)' -Force | Out-Null
        Write-Step "Scheduled: daily at $StartTime (task \MSP\$TaskName)."
        # The task was just re-registered with the installer's own time: forget which portal schedule was applied so the
        # next check-in applies the customer's choice again.
        Remove-Item -Force -Path (Join-Path $InstallDir 'schedule.json') -ErrorAction SilentlyContinue

        # The check-in task: every minute, outbound HTTPS only. It lets the portal show status, change the folder choice,
        # list/search/restore backups and start a backup on demand. Skipped when this installer has no portal address.
        if ($PortalUrl -and $AgentToken) {
            # Stop again now that the new scripts are in place: the every-minute trigger may have started a copy of the OLD
            # script since the first stop, and that copy would keep running its old code for hours.
            Stop-ScheduledTask -TaskName $PollTaskName -TaskPath $taskPath -ErrorAction SilentlyContinue
            $pAction   = New-ScheduledTaskAction -Execute 'powershell.exe' `
                           -Argument ('-NoProfile -ExecutionPolicy Bypass -File "{0}"' -f (Join-Path $InstallDir 'msp-poll.ps1'))
            $pTrigger  = New-ScheduledTaskTrigger -Once -At (Get-Date).AddMinutes(1) -RepetitionInterval (New-TimeSpan -Minutes 1) -RepetitionDuration (New-TimeSpan -Days 3650)
            $pSettings = New-ScheduledTaskSettingsSet -StartWhenAvailable -MultipleInstances IgnoreNew `
                           -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -ExecutionTimeLimit (New-TimeSpan -Hours 12)
            Register-ScheduledTask -TaskName $PollTaskName -TaskPath $taskPath -Action $pAction -Trigger $pTrigger `
                -Principal $taskUser -Settings $pSettings -Description 'MSP backup portal check-in (outbound HTTPS only)' -Force | Out-Null
            Write-Step "Portal check-in scheduled every minute (task \MSP\$PollTaskName)."
        }

        if ($RunNow) { Start-ScheduledTask -TaskName $TaskName -TaskPath $taskPath; Write-Step 'First backup started now (see backup.log in the install folder).' }
        Write-Step "OK: '$Machine' is set up for backup. Backed-up scope: $($pathsToUse -join ', ')"
    }
    finally {
        if (Test-Path $work) { Remove-Item -Recurse -Force -Path $work -ErrorAction SilentlyContinue }
    }
}
finally {
    Stop-Transcript | Out-Null
}
