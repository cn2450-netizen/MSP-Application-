# Pinned Restic build used by every backup agent and by the server-side maintenance jobs. The SHA256 values are the
# ones restic publishes in the release's SHA256SUMS (https://github.com/restic/restic/releases) and the installers
# refuse any download that does not match. To upgrade: change the version and ALL hashes together from the new
# SHA256SUMS. Keep agents and the server on the same version (repository format compatibility).
RESTIC_VERSION=0.19.1
RESTIC_URL_BASE=https://github.com/restic/restic/releases/download/v0.19.1
RESTIC_LINUX_AMD64_FILE=restic_0.19.1_linux_amd64.bz2
RESTIC_LINUX_AMD64_SHA256=f415415624dcc452f2a02b8c33641791a8c6d6d3b65bbb3543fcf9a25151585c
RESTIC_LINUX_ARM64_FILE=restic_0.19.1_linux_arm64.bz2
RESTIC_LINUX_ARM64_SHA256=a5f64aaab53d51e311fa3829124c5b703f2d14cf187d8640b6be3b2b49376465
RESTIC_WINDOWS_AMD64_FILE=restic_0.19.1_windows_amd64.zip
RESTIC_WINDOWS_AMD64_SHA256=da948ad707ed690426473aaba2046cd61f8f90f6f0e7dab6be0d5796531de67d
