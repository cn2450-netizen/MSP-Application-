<#
.SYNOPSIS
  MSP monitoring agent installer for customer "@@CUSTOMER@@".
  Generated by scripts/build-agent-installer.sh - do not edit by hand.

.DESCRIPTION
  Downloads a pinned Telegraf build (SHA256-verified; refuses to install on mismatch), installs it as the
  "MSPAgent" Windows service, and starts reporting metrics and event logs to the MSP platform.
  Safe to re-run: re-running upgrades or repairs the install.

.PARAMETER Uninstall
  Stop and remove the service and delete the install folder.

.NOTES
  Run from an elevated (Administrator) PowerShell:
      powershell -ExecutionPolicy Bypass -File .\install-agent-@@CUSTOMER@@.ps1
  This file contains this customer's write-only ingest credentials. Treat it as sensitive: deliver it
  securely and delete it after use. Those credentials can only SEND data; they cannot read anything.
#>
[CmdletBinding()]
param(
    [switch] $Uninstall,
    [string] $InstallDir = (Join-Path $env:ProgramFiles 'MSP-Agent')
)
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version 2.0

$Customer       = '@@CUSTOMER@@'
$TelegrafUrl    = '@@TELEGRAF_URL@@'
$TelegrafSha256 = '@@TELEGRAF_SHA256@@'
$ServiceName    = 'MSPAgent'
$ConfB64        = '@@CONF_B64@@'
$BitlockerB64   = '@@BITLOCKER_B64@@'

function Write-Step([string] $Message) { Write-Host "[MSP Agent] $Message" }

$identity  = [Security.Principal.WindowsIdentity]::GetCurrent()
$principal = New-Object Security.Principal.WindowsPrincipal($identity)
if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    throw 'This installer must be run from an elevated (Administrator) PowerShell.'
}

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
$logDir = Join-Path $env:ProgramData 'MSP-Agent'
New-Item -ItemType Directory -Force -Path $logDir | Out-Null
Start-Transcript -Path (Join-Path $logDir 'install.log') -Append | Out-Null

try {
    $exePath  = Join-Path $InstallDir 'telegraf.exe'
    $confPath = Join-Path $InstallDir 'telegraf.conf'
    $existing = Get-Service -Name $ServiceName -ErrorAction SilentlyContinue

    if ($Uninstall) {
        if ($existing) {
            if ($existing.Status -ne 'Stopped') { Stop-Service -Name $ServiceName -Force }
            if (Test-Path $exePath) { & $exePath service uninstall --service-name $ServiceName | Out-Null }
            else { & sc.exe delete $ServiceName | Out-Null }
        }
        if (Test-Path $InstallDir) { Remove-Item -Recurse -Force -Path $InstallDir }
        Write-Step 'Uninstalled.'
        return
    }

    # --- 1. Download and verify -------------------------------------------------
    $work = Join-Path ([IO.Path]::GetTempPath()) ('msp-agent-' + [guid]::NewGuid().ToString('N'))
    New-Item -ItemType Directory -Path $work | Out-Null
    try {
        $zip = Join-Path $work 'telegraf.zip'
        $verified = $false
        for ($attempt = 1; $attempt -le 4 -and -not $verified; $attempt++) {
            try {
                Write-Step "Downloading Telegraf (attempt $attempt of 4)..."
                Invoke-WebRequest -Uri $TelegrafUrl -OutFile $zip -UseBasicParsing
                $actual = (Get-FileHash -Path $zip -Algorithm SHA256).Hash.ToLower()
                if ($actual -eq $TelegrafSha256) { $verified = $true }
                else { Write-Step 'Download did not match the pinned SHA256 (incomplete or altered); discarding.' }
            } catch {
                Write-Step "Download failed: $($_.Exception.Message)"
            }
            if (-not $verified) {
                if (Test-Path $zip) { Remove-Item -Force -Path $zip }
                if ($attempt -lt 4) { Start-Sleep -Seconds (3 * $attempt) }
            }
        }
        if (-not $verified) {
            throw 'Could not obtain a Telegraf build matching the pinned SHA256. Nothing was installed.'
        }
        Write-Step 'Download verified (SHA256 matches).'

        Expand-Archive -Path $zip -DestinationPath (Join-Path $work 'x') -Force
        $newExe = Get-ChildItem -Path (Join-Path $work 'x') -Recurse -Filter 'telegraf.exe' | Select-Object -First 1
        if (-not $newExe) { throw 'telegraf.exe not found in the downloaded archive.' }

        # --- 2. Stop an existing install (upgrade/repair) ------------------------
        if ($existing) {
            Write-Step 'Existing install found; stopping it for upgrade.'
            if ($existing.Status -ne 'Stopped') { Stop-Service -Name $ServiceName -Force }
            if (Test-Path $exePath) { & $exePath service uninstall --service-name $ServiceName | Out-Null }
        }

        # --- 3. Files, config, permissions ---------------------------------------
        New-Item -ItemType Directory -Force -Path $InstallDir | Out-Null
        Copy-Item -Path $newExe.FullName -Destination $exePath -Force
        [IO.File]::WriteAllBytes((Join-Path $InstallDir 'bitlocker.ps1'), [Convert]::FromBase64String($BitlockerB64))

        $dirForToml = $InstallDir.Replace('\', '/')
        $conf = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($ConfB64)).Replace('{{AGENT_DIR}}', $dirForToml)
        [IO.File]::WriteAllText($confPath, $conf, (New-Object Text.UTF8Encoding($false)))   # no BOM

        # SYSTEM + Administrators only, by well-known SID so it works on any Windows language.
        & icacls.exe $InstallDir /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' | Out-Null

        # --- 4. Validate the config before installing ----------------------------
        Write-Step 'Checking configuration...'
        $check = & $exePath --config $confPath --test 2>&1 | Out-String
        if ($check -match 'E! loading config|invalid TOML|failed to load') {
            throw "Telegraf rejected the generated configuration:`n$check"
        }

        # --- 5. Install and start the service ------------------------------------
        Write-Step 'Installing the service...'
        & $exePath service install --config $confPath --service-name $ServiceName `
            --service-display-name 'MSP Monitoring Agent' --service-auto-restart --service-restart-delay 30s
        if ($LASTEXITCODE -ne 0) { throw "Service install failed (exit code $LASTEXITCODE)." }
        Start-Service -Name $ServiceName
        Write-Step "Service started. Waiting up to 60s to confirm data is being delivered..."

        # --- 6. Confirm delivery -------------------------------------------------
        $logFile = Join-Path $InstallDir 'telegraf.log'
        $problem = $null
        for ($i = 0; $i -lt 12; $i++) {
            Start-Sleep -Seconds 5
            if (Test-Path $logFile) {
                $problem = Select-String -Path $logFile -Pattern 'E! \[outputs\.' | Select-Object -Last 1
                if ($problem) { break }
            }
        }
        $svc = Get-Service -Name $ServiceName
        if ($svc.Status -ne 'Running') { throw "The service is not running (status: $($svc.Status)). See $logFile" }
        if ($problem) {
            Write-Warning "Installed, but the agent reported a delivery problem: $($problem.Line)"
            Write-Warning "Check network access to the ingest endpoint and the credentials. Log: $logFile"
        } else {
            Write-Step "OK: '$Customer' agent is running and no delivery errors were logged."
        }
    }
    finally {
        if (Test-Path $work) { Remove-Item -Recurse -Force -Path $work -ErrorAction SilentlyContinue }
    }
}
finally {
    Stop-Transcript | Out-Null
}
