# Pinned Telegraf build the installer downloads. The SHA256 is the value the vendor publishes in the
# GitHub release notes (https://github.com/influxdata/telegraf/releases) and was confirmed against a real
# download. The installer refuses anything that does not match. To upgrade: change all three lines
# together, using the hash from the new release notes.
TELEGRAF_VERSION=1.40.2
TELEGRAF_URL=https://dl.influxdata.com/telegraf/releases/telegraf-1.40.2_windows_amd64.zip
TELEGRAF_SHA256=062b33ee7e2400cdcee1fcd0601ede6b7ba7a1613d3f95b702abe176e1deee2c
