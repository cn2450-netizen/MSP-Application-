# Windows agent config template (ASCII only; keep it that way).
# scripts/build-agent-installer.sh fills customer values; the installer fills {{AGENT_DIR}} at install time.
# One agent ships metrics -> InfluxDB (customer bucket) and event logs -> Loki (customer tenant).
#
# TOML note: never put a Windows path (backslashes) inside a "..." string; every backslash is an escape.
# Paths here use forward slashes, which Windows and PowerShell accept.

[global_tags]
  customer = "{{CUSTOMER}}"        # convenience labels only; isolation is enforced server-side
  site = "{{SITE}}"

[agent]
  interval = "30s"
  flush_interval = "30s"
  round_interval = true
  omit_hostname = false
  # Outage buffering is RAM only (nothing is written to disk). Costs measured on Telegraf 1.40.2 / Windows:
  #   idle agent ~97 MB | ~0.7 KB per buffered metric | ~17 KB per buffered event-log entry.
  # The agent makes ~3,000 metrics/hour, so 200,000 metrics ride out ~66 hours offline (a long weekend) for ~140 MB.
  # Events are far bigger, so they get a smaller buffer below (5,000 events ~85 MB).
  # Worst case, both buffers full: ~330 MB total (~500 MB allowing 50% for GC slack): well inside a 1 GB ceiling.
  # When a buffer is full the OLDEST entries are dropped. A restart or reboot during an outage loses the buffer.
  metric_buffer_limit = 200000
  logfile = "{{AGENT_DIR}}/telegraf.log"
  logfile_rotation_max_size = "5MB"
  logfile_rotation_max_archives = 3

# -- Outputs -----------------------------------------------------------------

[[outputs.influxdb_v2]]
  urls = ["https://{{INGEST_HOST}}/influx"]
  token = "{{INFLUX_WRITE_TOKEN}}"      # bucket-scoped, write-only
  organization = "msp"
  bucket = "cust_{{CUSTOMER}}"
  namedrop = ["win_eventlog"]
  metric_buffer_limit = 200000

[[outputs.loki]]
  domain = "https://{{INGEST_HOST}}"
  endpoint = "/loki/api/v1/push"
  namepass = ["win_eventlog"]
  metric_buffer_limit = 5000     # events are ~17 KB each in memory; see the budget note in [agent]
  # The gateway maps this key to exactly one tenant. (Option name verified against Telegraf 1.40.2.)
  http_headers = {"Authorization" = "Bearer {{LOKI_PUSH_KEY}}"}

# -- Core health -------------------------------------------------------------

[[inputs.cpu]]
  percpu = false
  totalcpu = true
  report_active = false

[[inputs.mem]]

[[inputs.system]]

[[inputs.disk]]
  ignore_fs = ["tmpfs", "devtmpfs", "devfs", "iso9660", "overlay", "aufs", "squashfs"]

[[inputs.diskio]]

[[inputs.net]]

# Critical services. Extend per customer (SQL, AD, backup agents, AV, ...).
[[inputs.win_services]]
  service_names = [
    "EventLog", "Winmgmt", "RpcSs", "Schedule", "W32Time", "Dnscache",
    "LanmanServer", "LanmanWorkstation", "MpsSvc", "WinDefend", "wuauserv", "BITS",
  ]

# BitLocker (protection status, encryption %, locked) - see bitlocker.ps1.
# Array syntax (the string form is deprecated since Telegraf 1.39 and removed in 1.45). Forward slashes only.
[[inputs.exec]]
  commands = [["powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{{AGENT_DIR}}/bitlocker.ps1"]]
  data_format = "influx"
  timeout = "20s"
  interval = "300s"

# Drive letter + volume label, size and free space (adds the label Telegraf's disk input lacks) - see volumes.ps1
[[inputs.exec]]
  commands = [["powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{{AGENT_DIR}}/volumes.ps1"]]
  data_format = "influx"
  timeout = "30s"
  interval = "60s"

# Windows patch history (Windows Update history incl. failures + installed updates) - see patches.ps1.
# Every 15 min: Telegraf aligns each collector to the clock, so a new agent's first patch data can take up to
# one interval to appear.
[[inputs.exec]]
  commands = [["powershell.exe", "-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "{{AGENT_DIR}}/patches.ps1"]]
  data_format = "influx"
  timeout = "120s"
  interval = "15m"

# Backup result written by the backup agent after each run (agent/backup/windows/msp-backup.ps1). Absent file = no
# backup agent on this machine, which is fine. The line carries its own timestamp and last_success, so re-reading an
# unchanged file just rewrites the same point; the dashboard alerts on last_success going stale.
[[inputs.file]]
  files = ["C:/Program Files/MSP-Backup/status.influx"]
  data_format = "influx"
  interval = "300s"

# -- Logs (Warning and above; deliberately NOT the Security log) --------------

[[inputs.win_eventlog]]
  eventlog_name = "System"
  xpath_query = '''
    <QueryList><Query Id="0" Path="System">
      <Select Path="System">*[System[(Level=1 or Level=2 or Level=3)]]</Select>
    </Query></QueryList>'''
  from_beginning = false

[[inputs.win_eventlog]]
  eventlog_name = "Application"
  xpath_query = '''
    <QueryList><Query Id="0" Path="Application">
      <Select Path="Application">*[System[(Level=1 or Level=2 or Level=3)]]</Select>
    </Query></QueryList>'''
  from_beginning = false
