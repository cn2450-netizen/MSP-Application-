# Copy to .env (scripts/init-secrets.sh does this for you) and edit.
# No secrets live here — those are generated into ./secrets/.

# Public hostnames, served by NPM with TLS
AUTH_HOST=auth.example.com
MESH_HOST=remote.example.com
BACKUP_HOST=backup.example.com
PORTAL_HOST=portal.example.com
GRAFANA_HOST=grafana.example.com
INGEST_HOST=ingest.example.com
ADMIN_EMAIL=admin@example.com

# All persistent data. On the real deployment this is the mounted iSCSI LUN.
DATA_DIR=/srv/msp/data

# Published ports bind here. Keep loopback if NPM runs on this host;
# set to the host's LAN IP if NPM is elsewhere. Never 0.0.0.0 on an exposed box.
BIND_ADDR=127.0.0.1
AUTHENTIK_PORT=9000
GRAFANA_PORT=3000
GATEWAY_PORT=8080
MESH_PORT=4430
RESTIC_PORT=8000
PORTAL_PORT=3100
# "Replace this computer" needs a DIFFERENT technician to approve. Set 1 only in a lab with a single technician.
PORTAL_ALLOW_SELF_APPROVE=0

# Where the NAS backup share is mounted (see scripts/setup-backup-storage.sh).
BACKUP_DIR=/srv/msp-backups

# NPM's LAN address: MeshCentral trusts forwarded client addresses ONLY from this host.
NPM_IP=192.168.1.10

# Image tags. Verified to pull on amd64 when last tested; still check for newer
# releases / security fixes before deploying and bump here.
# (authentik 2025.2.4 is published arm64-only — don't use it.)
POSTGRES_TAG=16-alpine
AUTHENTIK_TAG=2026.8.5
INFLUX_TAG=2.9.1
LOKI_TAG=3.6.17
GRAFANA_TAG=12.4.13
NGINX_TAG=1.30.6-alpine3.24
MESH_TAG=1.2.6
RESTIC_SERVER_TAG=0.14.0
