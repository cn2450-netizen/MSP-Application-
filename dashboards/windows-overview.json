{
  "uid": "windows-overview",
  "title": "Windows Overview",
  "tags": [
    "msp",
    "windows"
  ],
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"host\")",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU used (5 min average)",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"cpu\" and r._field == \"usage_idle\" and r.cpu == \"cpu-total\" and r.host =~ /^${host:regex}$/) |> map(fn: (r) => ({r with _value: 100.0 - r._value})) |> mean() |> keep(columns: [\"host\", \"_value\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "displayName": "${__field.labels.host}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Memory used",
      "type": "gauge",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -5m) |> filter(fn: (r) => r._measurement == \"mem\" and r._field == \"used_percent\" and r.host =~ /^${host:regex}$/) |> last() |> keep(columns: [\"host\", \"_value\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "displayName": "${__field.labels.host}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Disk used",
      "type": "gauge",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"volume\" and r._field == \"used_percent\" and r.host =~ /^${host:regex}$/) |> last() |> keep(columns: [\"host\", \"name\", \"_value\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "displayName": "${__field.labels.host}  ${__field.labels.name}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Backups",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -30d) |> filter(fn: (r) => r._measurement == \"backup_run\" and r.host =~ /^${host:regex}$/ and (r._field == \"result_code\" or r._field == \"last_success\" or r._field == \"duration_s\" or r._field == \"data_added\" or r._field == \"bytes_processed\" or r._field == \"message\")) |> last() |> drop(columns: [\"_time\", \"_start\", \"_stop\"]) |> pivot(rowKey: [\"host\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> group() |> map(fn: (r) => ({r with age_h: float(v: int(v: now()) / 1000000000 - r.last_success) / 3600.0, last_success: r.last_success * 1000})) |> keep(columns: [\"host\", \"result_code\", \"last_success\", \"age_h\", \"duration_s\", \"bytes_processed\", \"data_added\", \"message\"]) |> rename(columns: {result_code: \"last_run\", last_success: \"last_good_backup\", age_h: \"hours_since_good\", duration_s: \"seconds\", bytes_processed: \"protected\", data_added: \"new_data\"})",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "last_run"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      },
                      "2": {
                        "text": "Partial",
                        "color": "orange",
                        "index": 1
                      },
                      "1": {
                        "text": "FAILED",
                        "color": "red",
                        "index": 2
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hours_since_good"
            },
            "properties": [
              {
                "id": "unit",
                "value": "h"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 30
                    },
                    {
                      "color": "red",
                      "value": 54
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "last_good_backup"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "protected"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "new_data"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "seconds"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "title": "BitLocker",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"bitlocker\" and r.host =~ /^${host:regex}$/ and (r._field == \"protection_status\" or r._field == \"encryption_percentage\" or r._field == \"volume_status\")) |> last() |> drop(columns: [\"_time\", \"_start\", \"_stop\"]) |> map(fn: (r) => ({r with name: if exists r.name then r.name else r.volume + \":\"})) |> pivot(rowKey: [\"host\", \"name\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> group() |> keep(columns: [\"host\", \"name\", \"protection_status\", \"encryption_percentage\", \"volume_status\"]) |> rename(columns: {name: \"volume\"})",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "protection_status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OFF",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "On",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "encryption_percentage"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 80
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Auto-start services NOT running",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"win_services\" and r.host =~ /^${host:regex}$/ and (r._field == \"state\" or r._field == \"startup_mode\")) |> last() |> pivot(rowKey: [\"host\", \"service_name\", \"display_name\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> filter(fn: (r) => r.startup_mode == 2 and r.state != 4) |> keep(columns: [\"host\", \"display_name\", \"service_name\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Windows update history (last 90 days, newest first)",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -90d) |> filter(fn: (r) => r._measurement == \"patch_history\" and r._field == \"title\" and r.host =~ /^${host:regex}$/) |> group(columns: [\"host\", \"kb\", \"result\", \"operation\", \"date\", \"source\"]) |> last() |> group() |> sort(columns: [\"date\"], desc: true) |> keep(columns: [\"host\", \"date\", \"kb\", \"result\", \"operation\", \"source\", \"_value\"]) |> rename(columns: {_value: \"title\"}) |> limit(n: 100)",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "result"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Failed": {
                        "color": "red",
                        "index": 0
                      },
                      "Aborted": {
                        "color": "red",
                        "index": 1
                      },
                      "SucceededWithErrors": {
                        "color": "orange",
                        "index": 2
                      },
                      "Succeeded": {
                        "color": "green",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "title": "Warnings / errors (System + Application)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Trends",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 10,
          "title": "CPU used % over time",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 35,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          },
          "targets": [
            {
              "refId": "A",
              "query": "from(bucket: v.defaultBucket) |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"cpu\" and r._field == \"usage_idle\" and r.cpu == \"cpu-total\" and r.host =~ /^${host:regex}$/) |> map(fn: (r) => ({r with _value: 100.0 - r._value})) |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
              "datasource": {
                "type": "influxdb",
                "uid": "influx"
              }
            }
          ],
          "options": {},
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100
            },
            "overrides": []
          }
        },
        {
          "id": 11,
          "title": "Memory used % over time",
          "type": "timeseries",
          "gridPos": {
            "x": 12,
            "y": 35,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          },
          "targets": [
            {
              "refId": "A",
              "query": "from(bucket: v.defaultBucket) |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"mem\" and r._field == \"used_percent\" and r.host =~ /^${host:regex}$/) |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
              "datasource": {
                "type": "influxdb",
                "uid": "influx"
              }
            }
          ],
          "options": {},
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100
            },
            "overrides": []
          }
        },
        {
          "id": 12,
          "title": "Disk used % over time",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 43,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          },
          "targets": [
            {
              "refId": "A",
              "query": "from(bucket: v.defaultBucket) |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"volume\" and r._field == \"used_percent\" and r.host =~ /^${host:regex}$/) |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> keep(columns: [\"_time\", \"_value\", \"host\", \"name\"])",
              "datasource": {
                "type": "influxdb",
                "uid": "influx"
              }
            }
          ],
          "options": {},
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "min": 0,
              "max": 100,
              "displayName": "${__field.labels.host}  ${__field.labels.name}"
            },
            "overrides": []
          }
        },
        {
          "id": 13,
          "title": "Disk free space over time",
          "type": "timeseries",
          "gridPos": {
            "x": 12,
            "y": 43,
            "w": 12,
            "h": 8
          },
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          },
          "targets": [
            {
              "refId": "A",
              "query": "from(bucket: v.defaultBucket) |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"volume\" and r._field == \"free_bytes\" and r.host =~ /^${host:regex}$/) |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false) |> keep(columns: [\"_time\", \"_value\", \"host\", \"name\"])",
              "datasource": {
                "type": "influxdb",
                "uid": "influx"
              }
            }
          ],
          "options": {},
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "min": 0,
              "displayName": "${__field.labels.host}  ${__field.labels.name}"
            },
            "overrides": []
          }
        }
      ]
    }
  ]
}
