{
  "uid": "windows-overview",
  "title": "Windows Overview",
  "tags": [
    "msp",
    "windows"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influx"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"host\")",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "CPU used %",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"cpu\" and r._field == \"usage_idle\" and r.cpu == \"cpu-total\" and r.host =~ /^${host:regex}$/) |> map(fn: (r) => ({r with _value: 100.0 - r._value})) |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Memory used %",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"mem\" and r._field == \"used_percent\" and r.host =~ /^${host:regex}$/) |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Disk used %",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"disk\" and r._field == \"used_percent\" and r.host =~ /^${host:regex}$/) |> last() |> keep(columns: [\"host\", \"path\", \"_value\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Auto-start services NOT running",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -15m) |> filter(fn: (r) => r._measurement == \"win_services\" and r.host =~ /^${host:regex}$/ and (r._field == \"state\" or r._field == \"startup_mode\")) |> last() |> pivot(rowKey: [\"host\", \"service_name\", \"display_name\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> filter(fn: (r) => r.startup_mode == 2 and r.state != 4) |> keep(columns: [\"host\", \"display_name\", \"service_name\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "BitLocker",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: v.defaultBucket) |> range(start: -1h) |> filter(fn: (r) => r._measurement == \"bitlocker\" and r.host =~ /^${host:regex}$/ and (r._field == \"protection_status\" or r._field == \"encryption_percentage\")) |> last() |> pivot(rowKey: [\"host\", \"volume\"], columnKey: [\"_field\"], valueColumn: \"_value\") |> keep(columns: [\"host\", \"volume\", \"protection_status\", \"encryption_percentage\"])",
          "datasource": {
            "type": "influxdb",
            "uid": "influx"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Warnings / errors (System + Application)",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=~\"$host\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}